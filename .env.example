# ---------------------------------------------------------------------------
# kyuar environment
#
# `just setup` copies this file to `.env` and symlinks every workspace package
# to it, so the repository has exactly one source of truth for secrets.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Token issued by @BotFather.
BOT_TOKEN=

# Random string sent as the X-Telegram-Bot-Api-Secret-Token header and checked
# on every webhook request. Generate with: just secret
BOT_WEBHOOK_SECRET=

# Bot username without the leading "@". Used to build t.me deep links.
# Use a separate bot for development: `just bot` removes the webhook of the bot
# it runs, which would take a shared production bot offline.
BOT_USERNAME=kyuarbot

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public origin of the web app. Read at runtime, so changing it needs a restart,
# not a rebuild. In development this is the cloudflared tunnel URL, in
# production the real domain, which must use https.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Redis used for per-client limits on /api/qr. docker-compose sets it to the
# bundled redis service. Leave empty in development to disable the limit.
REDIS_URL=

# Requests per client per minute on /api/qr.
RATE_LIMIT_PER_MINUTE=120

# Header that carries the real client IP. Set it to the header your reverse
# proxy writes, e.g. cf-connecting-ip behind Cloudflare. Clients can forge it
# when the app is reachable without the proxy.
CLIENT_IP_HEADER=x-forwarded-for

# ---------------------------------------------------------------------------
# Cloudflare tunnel (development only)
# ---------------------------------------------------------------------------

# Token of a named tunnel created in the Cloudflare Zero Trust dashboard.
# Leave empty to run `just tunnel` in quick mode with a temporary URL.
CLOUDFLARE_TUNNEL_TOKEN=
