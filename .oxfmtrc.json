{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index"]
  },
  "sortTailwindcss": {
    "entryPoint": "packages/ui/src/styles/globals.css"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    ".claude/**",
    "pnpm-lock.yaml",
    "LICENSE",
    "packages/qr-encoder/src/encoder.ts"
  ]
}
