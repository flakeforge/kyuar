{
  "name": "kyuar",
  "version": "0.1.0",
  "private": true,
  "description": "QR code generator that runs entirely inside Telegram",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter '@kyuar/web' --filter '@kyuar/bot' dev",
    "build": "pnpm --filter '@kyuar/web' build",
    "start": "pnpm --filter '@kyuar/web' start",
    "lint": "oxlint --deny-warnings --format=default",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r --no-bail typecheck",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.10.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react-doctor": "^0.9.14",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
